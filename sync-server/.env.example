# Laisser false pour écrire réellement dans Firebase.
DRY_RUN=false

WORLD_CUP_ENABLED=true
WORLD_CUP_API_URL=https://worldcup26.ir/get/games

# Source optionnelle d'informations complémentaires : https://www.football-data.org
# Créer un token gratuit puis l'ajouter ici.
