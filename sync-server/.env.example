FIREBASE_API_KEY=AIzaSyDIjQ5lfPcahptcaihe099tIYOCJ9IUnFk
FIREBASE_DATABASE_URL=https://zone-mondial-26-default-rtdb.europe-west1.firebasedatabase.app

